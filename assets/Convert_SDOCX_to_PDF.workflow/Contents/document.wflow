					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict>
					<key>source</key>
					<dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.applescript.object</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	set enginePath to "/Applications/SDOCX Converter.app/Contents/Resources/sdocx2pdf-macOS-arm64"
	set successCount to 0
	set lastStem to ""
	set allFiles to {}
	
	repeat with thisItem in input
		set posixPath to POSIX path of thisItem
		set checkCmd to "if [ -d " &amp; quoted form of posixPath &amp; " ]; then echo 'dir'; elif [ -f " &amp; quoted form of posixPath &amp; " ]; then echo 'file'; fi"
		try
			set itemType to do shell script checkCmd
			if itemType is "dir" then
				set findCmd to "find " &amp; quoted form of posixPath &amp; " -type f -iname '*.sdocx'"
				set foundList to paragraphs of (do shell script findCmd)
				repeat with f in foundList
					if length of f &gt; 0 then
						set end of allFiles to f
					end if
				end repeat
			else if itemType is "file" then
				if posixPath ends with ".sdocx" or posixPath ends with ".SDOCX" then
					set end of allFiles to posixPath
				end if
			end if
		end try
	end repeat
	
	repeat with aFile in allFiles
		set fPath to aFile as text
		set baseDir to do shell script "dirname " &amp; quoted form of fPath
		set baseName to do shell script "basename " &amp; quoted form of fPath
		set dotIdx to offset of ".sdocx" in baseName
		if dotIdx is 0 then
			set dotIdx to offset of ".SDOCX" in baseName
		end if
		if dotIdx &gt; 1 then
			set stem to text 1 thru (dotIdx - 1) of baseName
		else
			set stem to baseName
		end if
		set outPath to baseDir &amp; "/" &amp; stem &amp; ".pdf"
		
		try
			set cmd to quoted form of enginePath &amp; " --pen-width-multiplier 1.5 --marker-width-multiplier 1.0 " &amp; quoted form of fPath &amp; " " &amp; quoted form of outPath
			do shell script cmd
			set successCount to successCount + 1
			set lastStem to stem
		end try
	end repeat
	
	set appBin to "/Applications/SDOCX Converter.app/Contents/MacOS/SDOCX Converter"
	set notifTitle to "SDOCX Converter"
	if successCount is 1 then
		set notifMsg to "'" &amp; lastStem &amp; ".sdocx' 변환이 완료되었습니다."
		try
			do shell script quoted form of appBin &amp; " --notify " &amp; quoted form of notifTitle &amp; " " &amp; quoted form of notifMsg
		end try
	else if successCount &gt; 1 then
		set notifMsg to "총 " &amp; (successCount as text) &amp; "개 파일의 PDF 변환이 완료되었습니다."
		try
			do shell script quoted form of appBin &amp; " --notify " &amp; quoted form of notifTitle &amp; " " &amp; quoted form of notifMsg
		end try
	else if (count of allFiles) is 0 then
		set notifMsg to "선택한 폴더/항목에서 .sdocx 파일을 찾을 수 없습니다."
		try
			do shell script quoted form of appBin &amp; " --notify " &amp; quoted form of notifTitle &amp; " " &amp; quoted form of notifMsg
		end try
	end if
	
	return input
end run</string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.Automator.RunScript</string>
				<key>CFBundleVersion</key>
				<string>1.0.2</string>
